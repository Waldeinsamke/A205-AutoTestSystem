<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>A205自动测试系统</RootNamespace>
    <AssemblyName>A205自动测试系统</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- 默认 glob 会把整个目录的 .cs 编进来；显式排除不希望参与主编译的目录 -->
  <ItemGroup>
    <Compile Remove="legacy\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="migration\**" />
  </ItemGroup>

  <!-- SDK 风格默认会包含 Properties\Resources.resx 等嵌入式资源，无需手工列 -->
  <ItemGroup>
    <None Remove="Properties\Settings.settings" />
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <!-- NI-VISA 25.3 走 NuGet；本机需已装 NI-VISA 25Q2+ 驱动 -->
  <ItemGroup>
    <PackageReference Include="NationalInstruments.Visa" Version="25.3.0.11" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- NPOI 仍以 HintPath 引用 lib\ 下的 DLL（已验证可用，避免 NuGet 还原引入意外变化） -->
  <ItemGroup>
    <Reference Include="NPOI">
      <HintPath>lib\NPOI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OOXML">
      <HintPath>lib\NPOI.OOXML.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OpenXml4Net">
      <HintPath>lib\NPOI.OpenXml4Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OpenXmlFormats">
      <HintPath>lib\NPOI.OpenXmlFormats.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>lib\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Ivi.Visa 7.2 通过 NuGet 的 NationalInstruments.Visa 25.3 传递依赖提供，无需单独引用 -->
  </ItemGroup>

</Project>
