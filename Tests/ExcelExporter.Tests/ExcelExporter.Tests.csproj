<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ExcelExporter.Tests（M7 阶段，迁移至 .NET 8）。
    - 目标：net8.0-windows 控制台
    - 不引入 NUnit / xUnit / MSTest，自建 Assert 静态类
    - 通过 <ProjectReference> 引用主工程，业务代码与生产同源
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>A205AutoTestSystem.Tests.ExcelExporterTests</RootNamespace>
    <AssemblyName>ExcelExporter.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\A205自动测试系统.csproj" />
  </ItemGroup>

  <!-- NPOI 在主工程以 HintPath 方式引用 lib\ 下的 DLL，不会通过 ProjectReference 传递；
       这里直接复用主工程同源的 lib\NPOI.dll，保证 ExcelExporter.Tests 编译期可见。 -->
  <ItemGroup>
    <Reference Include="NPOI">
      <HintPath>..\..\lib\NPOI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OOXML">
      <HintPath>..\..\lib\NPOI.OOXML.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OpenXml4Net">
      <HintPath>..\..\lib\NPOI.OpenXml4Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>..\..\lib\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
