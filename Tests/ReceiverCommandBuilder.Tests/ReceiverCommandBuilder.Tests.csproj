<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ReceiverCommandBuilder 参数化单元测试工程（M2 阶段，迁移至 .NET 8）。
    - 目标：net8.0-windows 控制台
    - 不引入 NUnit / xUnit / MSTest，自建 Assert 静态类
    - 通过 <ProjectReference> 引用主工程，业务代码与生产同源
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>A205AutoTestSystem.Tests.BuilderTests</RootNamespace>
    <AssemblyName>ReceiverCommandBuilder.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\A205自动测试系统.csproj" />
  </ItemGroup>

</Project>
