<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoTest.Tests（M6 阶段，迁移至 .NET 8）。
    - 目标：net8.0-windows 控制台
    - 不引入 NUnit / xUnit / MSTest，自建 Assert 静态类
    - 通过 <ProjectReference> 引用主工程，业务代码与生产同源
    - 测试运行时通过 SetTransport() 注入 FakeVisaInstrument，与 NI VISA 驱动解耦
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>A205AutoTestSystem.Tests.AutoTestTests</RootNamespace>
    <AssemblyName>AutoTest.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\A205自动测试系统.csproj" />
  </ItemGroup>

  <!-- 同 ExcelExporter.Tests：NPOI 不随 ProjectReference 传递，直接复用 lib\NPOI.dll -->
  <ItemGroup>
    <Reference Include="NPOI">
      <HintPath>..\..\lib\NPOI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OOXML">
      <HintPath>..\..\lib\NPOI.OOXML.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NPOI.OpenXml4Net">
      <HintPath>..\..\lib\NPOI.OpenXml4Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>..\..\lib\ICSharpCode.SharpZipLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
