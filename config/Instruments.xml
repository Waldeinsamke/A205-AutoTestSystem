<?xml version="1.0" encoding="utf-8"?>
<!--
  仪表 VISA 资源地址配置。

  由产线/现场运维直接编辑本文件后重启程序（或在程序运行中点击“连接”重新加载）生效，
  不需要重新编译。请保持每个仪器的 resourceName 为该设备的真实资源名：
    - USB 仪表：USB0::<厂商ID>::0x<产品ID>::<序列号>::INSTR
    - LAN 仪表：TCPIP0::<IP>::inst0::INSTR 或 TCPIP0::<IP>::hislip0::INSTR
    - GPIB 仪表：GPIB0::<板号>::<地址>::INSTR
  任一项留空时，对应仪表在点击“连接”时会被标记为故障（节点变红）并在日志中说明原因。
-->
<Instruments>
  <RfGenerator resourceName="USB0::0x0957::0x1F01::MY61252673::INSTR" />
  <LoGenerator resourceName="USB0::0x0957::0x1F01::MY61250166::INSTR" />
  <SpectrumAnalyzer resourceName="USB0::0x2A8D::0x0A0B::MY51282426::INSTR" />
  <PowerSupply resourceName="USB0::0x5345::0x1234::2243132::INSTR" />
</Instruments>